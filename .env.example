# PostVias backend — environment variables
# Set these in Netlify (Site settings → Environment variables), NOT in the repo.
# Copy to .env for local `netlify dev`. Never commit real values (.env is gitignored).

# ── OpenAI (AI captions) ─────────────────────────────────────
OPENAI_API_KEY=          # sk-... from https://platform.openai.com/api-keys  (REQUIRED for captions)
OPENAI_MODEL=gpt-4o-mini # optional — override the model

# ── fal.ai (AI image generation) ─────────────────────────────
FAL_KEY=                 # from https://fal.ai/dashboard/keys  (REQUIRED for image generation)
FAL_MODEL=fal-ai/flux/schnell   # optional — e.g. fal-ai/flux/dev or fal-ai/flux-pro for higher quality

# ── Supabase (post + image persistence) ──────────────────────
SUPABASE_URL=            # https://<project>.supabase.co  (Project settings → API)
SUPABASE_SERVICE_KEY=    # service_role secret key (Project settings → API). SERVER-SIDE ONLY.
SUPABASE_BUCKET=generated   # optional — storage bucket name for generated images
